# Порт API и адрес магазина для ссылок восстановления
PORT=3002
APP_URL=http://127.0.0.1:3002

# Для отправки писем укажите действительные значения
# SMTP_URL=smtps://login:password@smtp.example.com:465
# MAIL_FROM=shop@example.com

# Для отдельного администратора задайте email и пароль до первого запуска
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=your-own-long-password
# COOKIE_SECURE=true
